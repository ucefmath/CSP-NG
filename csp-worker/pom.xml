  <artifactId>csp-worker</artifactId>
  <name>CSP-NG — Worker relais headless (sans PG, sans UI)</name>
  <description>
    Worker relais dataplane (listeners CCcam/CS378x, connecteurs amont assignes,
    pont CSPv2, canal controle HTTPS mTLS). Aucune dependance PG
    (reactive-pg-client, jdbc, Flyway), aucune UI (csp-web).
    Natif Debian 13 x86_64 : profil 'native' (GraalVM 21 LTS, baseline portable).
  </description>

  <properties>
    <!-- Baseline CPU portable x86-64 (jamais march=native). -->
    <native.march>compatibility</native.march>
    <!-- GraalVM 21 LTS : compatible Quarkus 3.20 / smallrye (voir runbook).
         Le plugin native-maven ignore cet element : build via
         JAVA_HOME="$HOME/.sdkman/candidates/java/21.0.5-graal"
         (jamais GraalVM 25, incompatible substitutions smallrye 2.12.2). -->
    <native.graalvm.home>${env.JAVA_HOME}</native.graalvm.home>
  </properties>

