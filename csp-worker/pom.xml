  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>shade-fat-jar</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.bowman.cspng.worker.WorkerMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Build natif GraalVM 21 LTS : mvn -B -pl csp-worker -am package -Pnative
         avec JAVA_HOME=.../21.0.5-graal. Baseline portable, pas de fallback. -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <executions>
              <execution>
                <id>shade-fat-jar</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>0.10.3</version>
            <extensions>true</extensions>
            <configuration>
              <metadataRepository>
                <enabled>true</enabled>
              </metadataRepository>
              <mainClass>com.bowman.cspng.worker.WorkerMain</mainClass>
              <buildArgs>
                <buildArg>--no-fallback</buildArg>
                <buildArg>-march=${native.march}</buildArg>
                <buildArg>--enable-https</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                <!-- Champs Unsafe des queues jctools shadees : conserves via
                     reflect-config.json (allDeclaredFields). Sans cela,
                     l'elimination closed-world casse getDeclaredField
                     ("producerIndex") au premier usage Netty (TLS inclus).
                     Aucun flag init aveugle : JUL/logmanager/smallrye ont
                     disparu du classpath (exclusions ci-dessus). -->
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
