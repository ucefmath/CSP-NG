# =====================================================================
# csp-app — EnvironmentFile systemd.  Cible : /etc/csp/csp.env
# Propriétaire root:csp, mode 0640. NE JAMAIS COMMITER la version remplie.
# Syntaxe systemd : KEY=VALUE, pas de `export`, pas d'expansion de variables.
# =====================================================================

# ---- PostgreSQL (local, loopback) ----
CSP_DB_HOST=127.0.0.1
CSP_DB_PORT=5432
CSP_DB_NAME=csp
CSP_DB_USER=csp
# openssl rand -hex 24
CSP_DB_PASSWORD=<GENERATE_ME>
# Mode SSL PostgreSQL : 'require' par défaut pour chiffrer le transport.
# Si le premier démarrage échoue avec une erreur de handshake SSL sur le client réactif Vert.x,
# essayer d'ajouter `QUARKUS_DATASOURCE_REACTIVE_TRUST_ALL=true` dans ce fichier avant de basculer
# en dernier recours vers `CSP_DB_SSL_MODE=disable` (uniquement si le trafic reste strictement
# loopback comme c'est le cas ici).
CSP_DB_SSL_MODE=require

# ---- HTTP / sessions admin ----
# NOTE : CSP_HTTP_PORT est SANS EFFET en profil prod (%prod.quarkus.http.port=8080
# a un ordinal supérieur). Pour changer le port, utiliser QUARKUS_HTTP_PORT.
# CSP_HTTP_PORT=8080

# ---- Bootstrap admin : 1er démarrage UNIQUEMENT ----
# À SUPPRIMER de ce fichier après création du compte (voir séquence de déploiement).
CSP_BOOTSTRAP_ADMIN_USER=admin
# openssl rand -hex 12
CSP_BOOTSTRAP_ADMIN_PASSWORD=<GENERATE_ME>

# ---- Runtime métier ----
# PHASE 1 (1er démarrage) : false — OBLIGATOIRE.
# La migration V1 sème un listener newcamd 0.0.0.0:15000 enabled=true avec
# des_key_ref='env:CSP_PROFILE_DES_KEY'. Avec runtime=true et la clé absente,
# le service fait fail-fast et ne démarre PAS ; avec la clé présente, il
# exposerait 0.0.0.0:15000 publiquement. Passer à true seulement APRÈS avoir
# désactivé ce listener en base (voir séquence de déploiement, étape 6).
CSP_RUNTIME_ENABLED=false

CSP_DCW_LINKS_FILE=/var/lib/csp/links.json

# =====================================================================
# NE PAS DÉFINIR sur ce déploiement :
#   CSP_PROFILE_DES_KEY, CSP_UDP_CLUSTER_ENABLED, CSP_CSPV2_ENABLED, CSP_INFINISPAN_*
# =====================================================================
